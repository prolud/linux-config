// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {
      // "shift shift": "file_finder::Toggle"
    },
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      // "j k": "vim::NormalBefore"
    },
  },
  {
    "context": "AcpThread > Editor",
    "unbind": {
      "ctrl-;": "agent::OpenAddContextMenu"
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "ctrl-;": "editor::ToggleLineNumbers"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-;": "terminal_panel::Toggle"
    }
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-`": "terminal_panel::Toggle"
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "ctrl-f12": "editor::GoToTypeDefinition"
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "f12": "editor::GoToDefinition"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "alt-shift-f": "editor::Format"
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "ctrl-shift-i": "editor::Format"
    }
  },
  {
    "context": "Pane",
    "unbind": {
      "ctrl-w": [
        "pane::CloseActiveItem",
        {
          "close_pinned": false
        }
      ]
    }
  },
  {
    "context": "Terminal",
    "unbind": {
      "ctrl-w": [
        "terminal::SendKeystroke",
        "ctrl-w"
      ]
    }
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-w": "workspace::CloseActiveDock"
    }
  },
  {
    "context": "SettingsWindow",
    "unbind": {
      "ctrl-w": "workspace::CloseWindow"
    }
  },
  {
    "context": "SkillCreator",
    "unbind": {
      "ctrl-w": "workspace::CloseWindow"
    }
  },
  {
    "context": "SkillCreator > Editor",
    "unbind": {
      "ctrl-w": "workspace::CloseWindow"
    }
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-f4": "workspace::CloseActiveDock"
    }
  },
  {
    "context": "Pane",
    "bindings": {
      "ctrl-w": [
        "pane::CloseActiveItem",
        {
          "close_pinned": false
        }
      ]
    }
  },
  {
    "context": "Pane",
    "unbind": {
      "ctrl-f4": [
        "pane::CloseActiveItem",
        {
          "close_pinned": false
        }
      ]
    }
  },
  {
    "unbind": {
      "ctrl-shift-w": "workspace::CloseWindow"
    }
  },
  {
    "context": "Terminal",
    "unbind": {
      "ctrl-shift-w": "pane::CloseActiveItem"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-shift-enter": "editor::NewlineAbove"
    }
  },
  {
    "bindings": {
      "ctrl-i": "editor::InsertSnippet"
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "ctrl-alt-f12": "editor::GoToTypeDefinitionSplit"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-f12": "editor::GoToImplementation"
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "shift-f12": "editor::GoToImplementation"
    }
  },
  {
    "context": "ApplicationMenu",
    "unbind": {
      "f10": "menu::Cancel"
    }
  },
  {
    "context": "Workspace",
    "unbind": {
      "f10": [
        "app_menu::OpenApplicationMenu",
        "Zed"
      ]
    }
  },
  {
    "unbind": {
      "f11": "zed::ToggleFullScreen"
    }
  },
  {
    "context": "Workspace && debugger_session",
    "bindings": {
      "f10": "debugger::StepOver"
    }
  },
  {
    "context": "Workspace && debugger_session",
    "unbind": {
      "f7": "debugger::StepOver"
    }
  },
  {
    "context": "Workspace && debugger_session",
    "bindings": {
      "f11": "debugger::StepInto"
    }
  },
  {
    "context": "Workspace && debugger_session",
    "unbind": {
      "ctrl-f11": "debugger::StepInto"
    }
  },
  {
    "bindings": {
      "ctrl-shift-f9": "debugger::ClearAllBreakpoints"
    }
  },
  {
    "context": "WorktreePicker || WorktreePicker > Picker > Editor",
    "unbind": {
      "ctrl-shift-c": "zed::OpenWorktreeSetupTasks"
    }
  },
  {
    "context": "WorktreePicker || WorktreePicker > Picker > Editor",
    "unbind": {
      "ctrl-shift-c": "zed::OpenWorktreeSetupTasks"
    }
  },
  {
    "context": "!Terminal",
    "unbind": {
      "ctrl-shift-c": "collab_panel::ToggleFocus"
    }
  },
  {
    "context": "WorktreePicker || WorktreePicker > Picker > Editor",
    "unbind": {
      "ctrl-shift-c": "zed::OpenWorktreeSetupTasks"
    }
  },
  {
    "context": "WorktreePicker || WorktreePicker > Picker > Editor",
    "unbind": {
      "ctrl-shift-c": "zed::OpenWorktreeSetupTasks"
    }
  },
  {
    "context": "WorktreePicker || WorktreePicker > Picker > Editor",
    "unbind": {
      "ctrl-shift-c": "zed::OpenWorktreeSetupTasks"
    }
  },
  {
    "context": "Pane",
    "bindings": {
      "alt-left": "pane::GoBack"
    }
  },
  {
    "context": "Pane",
    "unbind": {
      "ctrl-alt--": "pane::GoBack"
    }
  },
  {
    "context": "Pane",
    "bindings": {
      "alt-right": "pane::GoForward"
    }
  },
  {
    "context": "Pane",
    "unbind": {
      "ctrl-alt-_": "pane::GoForward"
    }
  }
]
